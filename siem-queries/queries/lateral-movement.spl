index=botsv3 sourcetype="xmlwineventlog:microsoft-windows-sysmon/operational" "<EventID>1</EventID>"
    ("psexec" OR "PSEXESVC" OR "wmic" OR "winrs" OR "paexec" OR "ADMIN$" OR "\\C$" OR "IPC$" OR "sc.exe \\\\" OR "net use \\\\")
| rex "Name=.Image.>(?<Image>[^<]+)"
| rex "Name=.CommandLine.>(?<CommandLine>[^<]+)"
| rex "Name=.User.>(?<User>[^<]+)"
| rex "Name=.ParentImage.>(?<ParentImage>[^<]+)"
| rex "<Computer>(?<Computer>[^<]+)"
| stats count values(CommandLine) as command_lines values(ParentImage) as parent_process by Computer User Image
| sort - count
